# Copy to .env and edit. Every setting has a safe default; with no .env at all
# the application runs on the offline engine with no network access.

# ---------------------------------------------------------------- engine
# auto (default) selects Anthropic when a key is set, offline otherwise.
# ADHIKAR_ENGINE=auto
# ADHIKAR_ANTHROPIC_API_KEY=sk-ant-...
# ADHIKAR_MODEL=claude-opus-5
# The verifier is configurable separately so the entailment gate can run on a
# different model from the generator. An independent checker is harder to talk
# past than the model that produced the claim.
# ADHIKAR_VERIFIER_MODEL=claude-opus-5
# ADHIKAR_EFFORT=high

# ------------------------------------------------------------ environment
# ADHIKAR_ENVIRONMENT=development
# ADHIKAR_DEBUG=false

# --------------------------------------------------------------- storage
# Only audit records are persisted; documents are never written to disk.
# ADHIKAR_DATABASE_URL=sqlite+aiosqlite:///./adhikar.db

# ---------------------------------------------------------------- limits
# ADHIKAR_MAX_UPLOAD_BYTES=10485760
# ADHIKAR_MAX_PDF_PAGES=300

# -------------------------------------------------------------- security
# Documents scoring at or above this for embedded instructions are refused.
# ADHIKAR_INJECTION_BLOCK_THRESHOLD=0.80
# ADHIKAR_INJECTION_WARN_THRESHOLD=0.35
# Cannot be disabled when ADHIKAR_ENVIRONMENT=production.
# ADHIKAR_REDACT_PII=true
# Minimum verifier confidence for a statement to be shown as fact.
# ADHIKAR_VERIFICATION_THRESHOLD=0.70
# ADHIKAR_RATE_LIMIT_REQUESTS=30
# ADHIKAR_UPLOAD_RATE_LIMIT_REQUESTS=10
