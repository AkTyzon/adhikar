# Copy to .env.local. Every value is optional.
#
# With no key at all, the five scenario cards still return complete answers with
# verified citations, so the app is demonstrable on a fresh clone. Document
# analysis and free-text questions need a model.
#
# The first key found wins, in this order.

# Google Gemini
# GOOGLE_GENERATIVE_AI_API_KEY=

# OpenAI
# OPENAI_API_KEY=

# Anthropic Claude
# ANTHROPIC_API_KEY=

# Override the model for whichever provider was selected. Defaults:
#   gemini-2.0-flash / gpt-4o-mini / claude-sonnet-4-5
# ADHIKAR_MODEL=
